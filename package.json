{
  "name": "radar-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Avisador personal de radares, helicópteros Pegasus de la DGT e incidencias de tráfico en España (PWA + servidor proxy).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@preact/signals": "^2.11.3",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.12",
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^5.24.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
